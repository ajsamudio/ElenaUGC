# Copy this file to .env.local (and add the same vars in Vercel → Settings → Environment Variables).

# Free API key at https://resend.com (Settings -> API Keys)
RESEND_API_KEY=

# Where inquiry emails go. Comma-separate to send to more than one inbox,
# e.g. Elena + her manager at Nowadays Talent.
INQUIRY_TO_EMAIL=elenapartida01@gmail.com

# Until you verify a domain in Resend, keep Resend's shared sender.
INQUIRY_FROM_EMAIL=onboarding@resend.dev
